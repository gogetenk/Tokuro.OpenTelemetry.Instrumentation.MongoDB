<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Suppress NuGet vulnerability warnings-as-errors for transitive deps we don't directly own.
         These come from MongoDB.Driver (Snappier, SharpCompress) and from older OpenTelemetry.Api
         releases. Surfaced as warnings (NuGet audit still runs); just not failing the build. -->
    <NoWarn>$(NoWarn);NU1900;NU1901;NU1902;NU1903;NU1904</NoWarn>
    <EnableNetAnalyzers>true</EnableNetAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Common NuGet package metadata -->
  <PropertyGroup>
    <Authors>Yannis Tocreau</Authors>
    <Company>Yannis Tocreau</Company>
    <Copyright>Copyright (c) 2026 Yannis Tocreau and contributors</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/OWNER/Tokuro.OpenTelemetry.Instrumentation.MongoDB</PackageProjectUrl>
    <RepositoryUrl>https://github.com/OWNER/Tokuro.OpenTelemetry.Instrumentation.MongoDB</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>opentelemetry;otel;mongodb;tracing;observability;instrumentation</PackageTags>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- Pack README and LICENSE into all packable projects -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
