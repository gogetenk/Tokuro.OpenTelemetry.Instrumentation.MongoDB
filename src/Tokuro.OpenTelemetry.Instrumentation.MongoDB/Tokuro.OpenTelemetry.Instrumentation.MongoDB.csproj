<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <PackageId>Tokuro.OpenTelemetry.Instrumentation.MongoDB</PackageId>
    <AssemblyName>Tokuro.OpenTelemetry.Instrumentation.MongoDB</AssemblyName>
    <RootNamespace>Tokuro.OpenTelemetry.Instrumentation.MongoDB</RootNamespace>
    <Description>PII-safe OpenTelemetry instrumentation for MongoDB.Driver — redacts BSON command payloads by default, suppresses exception messages, dual-writes legacy + stable OTel database semantic conventions.</Description>
    <PackageTags>opentelemetry;otel;mongodb;tracing;observability;instrumentation;activitysource</PackageTags>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MongoDB.Driver" />
    <PackageReference Include="System.Diagnostics.DiagnosticSource" />
    <PackageReference Include="OpenTelemetry.Api" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tokuro.OpenTelemetry.Instrumentation.MongoDB.Tests" />
    <InternalsVisibleTo Include="Tokuro.OpenTelemetry.Instrumentation.MongoDB.Benchmarks" />
  </ItemGroup>

</Project>
